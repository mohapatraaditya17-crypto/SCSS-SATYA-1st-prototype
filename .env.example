# SCSS SATYA — Environment Configuration Example
# Copy to .env for custom local configuration

# Application Info
PROJECT_NAME="SCSS SATYA"
TOOL_VERSION="1.0.0"
ORGANIZATION="Sure Clue Scientific Solutions (SCSS)"

# Server Configuration
HOST="127.0.0.1"
PORT=8000
DEBUG=false

# Security & Upload Limits
MAX_UPLOAD_SIZE_BYTES=15728640  # 15 MB
MAX_IMAGE_PIXELS=50000000        # 50 Megapixels max

# Storage & Database
DATABASE_URL="sqlite:///storage/satya_forensics.db"

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:8000"
